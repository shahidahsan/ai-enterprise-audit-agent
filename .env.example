# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith observability
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=compliance-audit-agent

# Postgres + pgvector (see Dockerfile.postgres / docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=audit_agent
POSTGRES_USER=audit_agent
POSTGRES_PASSWORD=audit_agent

# Ingestion / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
